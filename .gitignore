# ============ Unity ============
# Carpetas que Unity regenera solo: NUNCA se suben
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Los .meta SÍ se suben (guardan las referencias entre archivos)
!/[Aa]ssets/**/*.meta

# Generados por los editores de código
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
sysinfo.txt
crashlytics-build.properties
/[Aa]ssets/Plugins/Editor/JetBrains*

# Compilaciones (los APK se comparten por otro lado, no en el repo)
*.apk
*.aab
*.unitypackage
*.app

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ============ Blender ============
# Copias de seguridad automáticas
*.blend1
*.blend2
*.blend3

# ============ Sistema ============
.DS_Store
Thumbs.db
desktop.ini
